rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isRestaurantStaff() {
      return isSignedIn() && request.auth.token.restaurantId is string;
    }

    function isDriverStaff() {
      return isSignedIn() && request.auth.token.driverId is string;
    }

    function isStaff() {
      return isAdmin() || isRestaurantStaff() || isDriverStaff();
    }

    // Customer orders remain accessible to their owner, while staff workflow
    // access is controlled by Firebase custom claims.
    match /orders/{orderId} {
      allow create: if isStaff() ||
        (
          isSignedIn() &&
          request.resource.data.userId == request.auth.uid
        );
      allow read: if isSignedIn() &&
        (
          isStaff() ||
          resource.data.userId == request.auth.uid
        );
      allow update: if isStaff();
      allow delete: if false;
    }

    // Backward compatibility for older docs written with capitalized collection name.
    match /Orders/{orderId} {
      allow create: if isStaff() ||
        (
          isSignedIn() &&
          request.resource.data.userId == request.auth.uid
        );
      allow read: if isSignedIn() &&
        (
          isStaff() ||
          resource.data.userId == request.auth.uid
        );
      allow update: if isStaff();
      allow delete: if false;
    }

    // Allow authenticated users to read/write their own user profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /Users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Admin prototype collections
    match /adminRestaurants/{restaurantId} {
      allow read: if isStaff();
      allow write: if isAdmin() ||
        (
          isRestaurantStaff() &&
          request.auth.token.restaurantId == restaurantId
        );
    }

    match /adminFeedback/{feedbackId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read: if isStaff();
      allow write: if isAdmin() ||
        (
          isDriverStaff() &&
          request.auth.token.driverId == driverId
        );
    }

    // Allow reading restaurants (public data)
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Allow reading menu items (public data)
    match /menu/{menuId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
