rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isRestaurantStaff() {
      return isSignedIn() && request.auth.token.restaurantId is string;
    }

    function isDriverStaff() {
      return isSignedIn() && request.auth.token.driverId is string;
    }

    function isGoogleAggregator() {
      // The hardcoded email is a fallback so the aggregator account can
      // operate before its custom claim has been provisioned. Production
      // setups should rely on the custom claim once it is configured.
      return isSignedIn() && (
        request.auth.token.googleAggregator == true ||
        request.auth.token.email == "google@fusionyum.com"
      );
    }

    function isStaff() {
      return isAdmin() ||
        isRestaurantStaff() ||
        isDriverStaff() ||
        isGoogleAggregator();
    }

    function isRestaurantOwner(restaurantId) {
      return isRestaurantStaff() &&
        request.auth.token.restaurantId == restaurantId;
    }

    function isDriverOwner(driverId) {
      return isDriverStaff() &&
        request.auth.token.driverId == driverId;
    }

    function ownsOrder(data) {
      return isSignedIn() &&
        ("userId" in data) &&
        data.userId == request.auth.uid;
    }

    function restaurantOwnsOrder(data) {
      return isRestaurantStaff() &&
        ("restaurantId" in data) &&
        data.restaurantId == request.auth.token.restaurantId;
    }

    function driverOwnsOrder(data) {
      return isDriverStaff() &&
        ("driverId" in data) &&
        data.driverId == request.auth.token.driverId;
    }

    function googleAggregatorOwnsOrder(data) {
      // Use a string-range check (matching the aggregator's range query in
      // app/Firebase/admin.ts) instead of `matches()`. Firestore's rule
      // analyzer pre-validates queries against rules and cannot prove that
      // a range constraint implies a regex match, so a regex here causes
      // the aggregator's collection query to be rejected upfront.
      return isGoogleAggregator() &&
        ("restaurantId" in data) &&
        data.restaurantId is string &&
        data.restaurantId >= "google-" &&
        data.restaurantId < "google.";
    }

    function orderIsReadyForDriver(data) {
      return (
        (("status" in data) && data.status in ["ready", "Ready for Driver"]) ||
        (("adminStatus" in data) && data.adminStatus == "Ready for Driver")
      );
    }

    function orderIsUnassigned(data) {
      return !("driverId" in data) ||
        data.driverId == null ||
        data.driverId == "" ||
        (("driver" in data) && data.driver == "Unassigned");
    }

    function driverCanReadAvailableOrder(data) {
      return isDriverStaff() &&
        orderIsReadyForDriver(data) &&
        orderIsUnassigned(data);
    }

    function canReadOrder(data) {
      return isAdmin() ||
        ownsOrder(data) ||
        restaurantOwnsOrder(data) ||
        googleAggregatorOwnsOrder(data) ||
        driverOwnsOrder(data) ||
        driverCanReadAvailableOrder(data);
    }

    function isCustomerOrderCreate() {
      return isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.restaurantId is string &&
        request.resource.data.keys().hasOnly([
          "adminStatus",
          "createdAt",
          "customer",
          "deliveryAddress",
          "deliveryFee",
          "deliveryNote",
          "driver",
          "driverId",
          "driverName",
          "eta",
          "issue",
          "items",
          "placedAt",
          "restaurant",
          "restaurantId",
          "restaurantName",
          "specialInstructions",
          "status",
          "subtotal",
          "taxes",
          "tip",
          "total",
          "totalAmount",
          "updatedAt",
          "userId"
        ]) &&
        request.resource.data.status == "pending" &&
        request.resource.data.adminStatus == "Pending" &&
        (!("driverId" in request.resource.data) ||
          request.resource.data.driverId == null) &&
        (!("driverName" in request.resource.data) ||
          request.resource.data.driverName == null) &&
        (!("issue" in request.resource.data) ||
          request.resource.data.issue == null);
    }

    function isRestaurantOrderStatusUpdate() {
      return restaurantOwnsOrder(resource.data) &&
        request.resource.data.restaurantId == resource.data.restaurantId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "adminStatus",
          "eta",
          "updatedAt"
        ]) &&
        request.resource.data.status in ["preparing", "ready"] &&
        request.resource.data.adminStatus in ["Preparing", "Ready for Driver"];
    }

    // The Google aggregator can transition orders Preparing / Ready for any
    // Google-sourced restaurant. Same shape as the restaurant rule above
    // but scoped to google-* restaurantIds.
    function isGoogleAggregatorOrderStatusUpdate() {
      return googleAggregatorOwnsOrder(resource.data) &&
        request.resource.data.restaurantId == resource.data.restaurantId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "adminStatus",
          "eta",
          "updatedAt"
        ]) &&
        request.resource.data.status in ["preparing", "ready"] &&
        request.resource.data.adminStatus in ["Preparing", "Ready for Driver"];
    }

    function isDriverClaimUpdate() {
      return isDriverStaff() &&
        orderIsReadyForDriver(resource.data) &&
        orderIsUnassigned(resource.data) &&
        request.resource.data.driverId == request.auth.token.driverId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "adminStatus",
          "driver",
          "driverId",
          "driverName",
          "eta",
          "issue",
          "updatedAt"
        ]) &&
        request.resource.data.status in ["ready", "Ready for Driver"] &&
        request.resource.data.adminStatus == "Ready for Driver";
    }

    function isDriverPickupUpdate() {
      return driverOwnsOrder(resource.data) &&
        request.resource.data.driverId == resource.data.driverId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "adminStatus",
          "eta",
          "updatedAt"
        ]) &&
        request.resource.data.status == "out_for_delivery" &&
        request.resource.data.adminStatus == "Out for Delivery";
    }

    function isDriverDeliveryUpdate() {
      return driverOwnsOrder(resource.data) &&
        request.resource.data.driverId == resource.data.driverId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "adminStatus",
          "eta",
          "issue",
          "updatedAt"
        ]) &&
        request.resource.data.status == "delivered" &&
        request.resource.data.adminStatus == "Completed";
    }

    function isDriverOrderUpdate() {
      return isDriverClaimUpdate() ||
        isDriverPickupUpdate() ||
        isDriverDeliveryUpdate();
    }

    // Customer reports a problem with their own order. Locked down to just
    // the issue summary string, structured issueReport, and updatedAt so a
    // customer cannot mutate totals, items, status, or delivery details.
    function isCustomerIssueReport() {
      return ownsOrder(resource.data) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "issue",
          "issueReport",
          "updatedAt"
        ]);
    }

    function isRestaurantProfileUpdate(restaurantId) {
      return isRestaurantOwner(restaurantId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "menuItems",
          "avgPrepTime",
          "updatedAt"
        ]);
    }

    function isDriverProfileUpdate(driverId) {
      return isDriverOwner(driverId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "updatedAt"
        ]) &&
        request.resource.data.status in [
          "Available",
          "Delivering",
          "Offline"
        ];
    }

    // Customer orders remain accessible to their owner, while staff workflow
    // access is controlled by Firebase custom claims.
    match /orders/{orderId} {
      allow create: if isAdmin() || isCustomerOrderCreate();
      allow read: if isSignedIn() && canReadOrder(resource.data);
      allow update: if isAdmin() ||
        isCustomerIssueReport() ||
        isRestaurantOrderStatusUpdate() ||
        isGoogleAggregatorOrderStatusUpdate() ||
        isDriverOrderUpdate();
      allow delete: if false;
    }

    // Backward compatibility for older docs written with capitalized collection name.
    match /Orders/{orderId} {
      allow create: if isAdmin() || isCustomerOrderCreate();
      allow read: if isSignedIn() && canReadOrder(resource.data);
      allow update: if isAdmin() ||
        isCustomerIssueReport() ||
        isRestaurantOrderStatusUpdate() ||
        isGoogleAggregatorOrderStatusUpdate() ||
        isDriverOrderUpdate();
      allow delete: if false;
    }

    // Allow authenticated users to read/write their own user profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /Users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Admin prototype collections
    match /adminRestaurants/{restaurantId} {
      allow read: if isAdmin() || isRestaurantOwner(restaurantId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isRestaurantProfileUpdate(restaurantId);
    }

    match /adminFeedback/{feedbackId} {
      allow read: if isAdmin() || restaurantOwnsOrder(resource.data);
      allow write: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read: if isAdmin() || isDriverOwner(driverId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isDriverProfileUpdate(driverId);
    }

    // Allow reading restaurants (public data)
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if isAdmin() || isRestaurantOwner(restaurantId);
    }

    // Allow reading menu items (public data)
    match /menu/{menuId} {
      allow read: if true;
      allow write: if isAdmin() ||
        (
          isRestaurantStaff() &&
          request.resource.data.restaurantId == request.auth.token.restaurantId
        );
    }
  }
}
