# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored; never commit real keys.
#
# To get a Google Places API key:
#   1. https://console.cloud.google.com/
#   2. Enable "Places API" in APIs & Services -> Library
#   3. Credentials -> Create Credentials -> API Key
#   4. Restrict the key appropriately for your runtime.
#
# For demo admin seed data, leave seeding disabled unless you are running a
# local development Firebase project.
#
# After editing .env, restart Metro with cache cleared:
#   npx expo start --clear

EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_SIGN_IN_WEB_CLIENT_ID=
EXPO_PUBLIC_ENABLE_DEMO_SEEDING=false
